# MandiMitra Environment Configuration
# Copy this file to .env.local to configure live SMS delivery and database settings

# =========================================================================
# SMS NOTIFICATION GATEWAYS (OPTIONAL)
# If left blank, the application automatically runs in "Interactive Simulation Mode",
# displaying incoming SMS via native lockscreen push alerts and an in-app SMS inbox.
# =========================================================================

# OPTION 1: Fast2SMS (Recommended for Indian numbers +91)
# Sign up at https://www.fast2sms.com and paste your API key below:
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# OPTION 2: Twilio SMS Gateway (Global)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# OPTION 3: Custom SMS Webhook Gateway
# SMS_WEBHOOK_URL=https://your-custom-sms-webhook.com/api/send

# =========================================================================
# DATABASE (OPTIONAL)
# DATABASE_URL="postgresql://user:password@localhost:5432/mandimitra?schema=public"
# =========================================================================
